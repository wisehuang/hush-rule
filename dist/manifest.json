{
  "manifest_version": 3,
  "name": "Hush Rules",
  "version": "1.0.0",
  "description": "Automatically mute tabs by custom domain and URL rules.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hush Rules – click to mute or unmute this tab",
    "default_icon": {
      "16": "icons/action-unmuted-16.png",
      "32": "icons/action-unmuted-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
